mainmenu "CogniPilot - SPINALI - CAN over Ethernet"
menu "Zephyr"
source "Kconfig.zephyr"
endmenu

menu "COE"

config SPINALI_COE_STREAM_UID_BASE
  hex "Base IEEE 1722 stream index"
  default 0x0000
  range 0 0xffff
  help
    IEEE 1722 stream IDs are formed as the talker interface MAC address in
    the upper 48 bits and a 16 bit stream index in the lower 16 bits, so
    every node's streams are unique on the network without coordination.
    Bus N transmits and accepts the stream index STREAM_UID_BASE + N. Leave
    this at zero unless one node must expose more than one CAN bus group.

config SPINALI_COE_DST_MAC
  string "Destination MAC address for outbound AVTPDUs"
  default "91:E0:F0:00:0C:0E"
  help
    Colon separated destination MAC address of the AVTPDUs sent from each
    CAN bus. The default is a multicast address inside the MAAP dynamic
    pool. The source MAC of the first valid inbound AVTPDU replaces this
    address, so a unicast peer is followed automatically. A string that
    cannot be parsed falls back to the multicast default.

module = SPINALI_COE
module-str = spinali_coe
source "subsys/logging/Kconfig.template.log_config"
endmenu
