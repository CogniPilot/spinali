#include <zephyr/dt-bindings/sensor/rm3100.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/* Console on the FC1 UART (J5 debug connector). The board-level
 * i3c_workaround moved the console to USB CDC to free FC1 for the BMM350;
 * this app uses the shield RM3100 instead, so FC1 returns to UART.
 */
/delete-node/ &bmm350_0;

/ {
	chosen {
		zephyr,console = &flexcomm1_lpuart1;
		zephyr,shell-uart = &flexcomm1_lpuart1;
		zephyr,uart-mcumgr = &flexcomm1_lpuart1;
	};

	aliases {
		imu-stream-0 = &icm45686_0;
		mag-stream-0 = &rm3100_0;
		gnss = &gnss1;
	};
};

&flexcomm1_lpi2c1 {
	status = "disabled";
};

&flexcomm1_lpuart1 {
	status = "okay";
};

/* USB Shell IRQ priority lower than SPI IRQs */
&zephyr_udc0 {
	interrupts = <0x43 0x6>;
};

#include <zephyr/dt-bindings/sensor/icm45686.h>

&icm45686_0 {
	/* Configure to output 4-samples every 1.25-ms (800-Hz) */
	accel-odr = <ICM45686_DT_ACCEL_ODR_3200>;
	gyro-odr = <ICM45686_DT_GYRO_ODR_3200>;
	fifo-watermark = <4>;
	fifo-watermark-equals;
};

/* Disable icm45686_1 - FC7 is used for GNSS corrections UART */
&icm45686_1 {
	status = "disabled";
};

/* Disable optical flow board sensors - FC3 is used for GNSS UART */
&afbr_s50 {
	status = "disabled";
};

&paa3905 {
	status = "disabled";
};

&icm42688 {
	status = "disabled";
};

/* Disable optical flow SPI interfaces */
&flexcomm6_lpspi6 {
	status = "disabled";
};

&flexcomm9_lpspi9 {
	status = "disabled";
};

/* Reconfigure FlexCOMM3 from SPI (optical flow) to UART.
 * FC3 wires to the F9P's UART2 (TXD2/RXD2): spare / base-station RTCM
 * output port. Kept enabled as a plain UART.
 */
&flexcomm3_lpspi3 {
	status = "disabled";
};

&flexcomm3_lpuart3 {
	status = "okay";
	pinctrl-0 = <&pinmux_flexcomm3_lpuart>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/* GNSS primary UART: FC7 wires to the F9P's UART1 (TXD1/RXD1). */
&flexcomm7_lpspi7 {
	status = "disabled";
};

&flexcomm7_lpuart7 {
	status = "okay";
	pinctrl-0 = <&pinmux_flexcomm7_lpuart>;
	pinctrl-names = "default";
	current-speed = <115200>;

	gnss1: gnss {
		status = "okay";
		compatible = "u-blox,f9p";
		fix-rate = <100>;
		initial-baudrate = <38400>;
		reset-gpios = <&gpio3 7 GPIO_ACTIVE_LOW>;
	};
};

/* PNI RM3100 magnetometer on FC4 (P1_8 SDA / P1_9 SCL, DRDY P1_22) */
&flexcomm4 {
	status = "okay";
};

&flexcomm4_lpi2c4 {
	status = "okay";
	pinctrl-0 = <&pinmux_flexcomm4_lpi2c>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	/* Address 0x23: SA0 (SSN) and SA1 (MISO) are unconnected on the
	 * shield and float high via the chip's internal pulls.
	 */
	rm3100_0: rm3100@23 {
		status = "okay";
		compatible = "pni,rm3100";
		reg = <0x23>;
		int-gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
		odr = <RM3100_DT_ODR_150>;
	};
};

/* Pinctrl for GNSS UARTs and RM3100 I2C */
&pinctrl {
	/* F9P UART2 (TXD2/RXD2): corrections/base output port */
	pinmux_flexcomm3_lpuart: pinmux_flexcomm3_lpuart {
		group0 {
			pinmux = <FC3_P0_PIO1_0>,
				 <FC3_P1_PIO1_1>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
		};
	};

	/* GNSS primary UART (F9P TXD1/RXD1) */
	pinmux_flexcomm7_lpuart: pinmux_flexcomm7_lpuart {
		group0 {
			pinmux = <FC7_P0_PIO3_2>,
				 <FC7_P1_PIO3_3>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
		};
	};

	/* RM3100 I2C (external pull-ups on hub) */
	pinmux_flexcomm4_lpi2c: pinmux_flexcomm4_lpi2c {
		group0 {
			pinmux = <FC4_P0_PIO1_8>,
				 <FC4_P1_PIO1_9>;
			slew-rate = "fast";
			drive-strength = "low";
			drive-open-drain;
			input-enable;
		};
	};

	/* F9P TIMEPULSE on P3_8 as CTIMER capture input (CT_INP4) */
	pinmux_ctimer_pps: pinmux_ctimer_pps {
		group0 {
			pinmux = <CT_INP4_PIO3_8>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
		};
	};
};

/* INPUTMUX: routes CT_INP4 onto CTIMER4 capture channel 0. The SoC dtsi
 * models inputmux0 (disabled) at offset 0x6000 in the peripheral space
 * (0x50006000 secure alias); enable it here for the capture route.
 */
&inputmux0 {
	status = "okay";
};

/* CTIMER4 hardware-captures the F9P TIMEPULSE edge. board.c attaches
 * PLL0 (150 MHz, div 1) when this node is enabled - the same clock
 * domain as the ENET QoS PTP reference, so captured ticks translate
 * exactly to PHC time. 0x1C000004 = kINPUTMUX_CtimerInp4ToTimer4Captsel.
 */
&ctimer4 {
	status = "okay";
	pinctrl-0 = <&pinmux_ctimer_pps>;
	pinctrl-names = "default";
	mux-states = <&inputmux0 0 0x1C000004>;
};

/* ENET QoS PTP hardware clock (PHC): the clock being disciplined. */
&enet_ptp_clock {
	status = "okay";
};

/* User buttons and GNSS fix LED. (The F9P timepulse on P3_8 is muxed
 * to CT_INP4 for CTIMER capture - see pinmux_ctimer_pps/&ctimer4 -
 * not claimed as a GPIO.)
 */
/ {
	gpio_keys {
		compatible = "gpio-keys";
		button_sw1: button_sw1 {
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			label = "SW1";
			zephyr,code = <INPUT_KEY_0>;
		};
		button_sw2: button_sw2 {
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			label = "SW2";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	gnss_leds {
		compatible = "gpio-leds";
		led_gpsfix: led_gpsfix {
			gpios = <&gpio3 9 GPIO_ACTIVE_HIGH>;
			label = "GPSFIX";
		};
	};

	/* P3_0 reaches the F9P's EXTINT input through a 0R link on the
	 * shield. Driven as a plain output (idle low, pulsed high) to
	 * mark a PHC-timed edge the receiver timestamps in GNSS time,
	 * which measures absolute grandmaster error.
	 */
	zephyr,user {
		timemark-gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
	};
};
