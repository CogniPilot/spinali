config SPINALI_SYNAPSE_ZENOH
	bool "Zenoh Transport"
	default n
	depends on ZROS
	help
	  Zenoh transport publishing the synapse optical flow topics as
	  raw fixed-layout structs tagged with their catalog value contract.

if SPINALI_SYNAPSE_ZENOH

choice
	prompt "Zenoh session mode"
	default SPINALI_SYNAPSE_ZENOH_MODE_CLIENT
	help
	  Client mode connects to a zenoh router. Peer mode joins a router-less
	  peer-to-peer mesh and discovers other peers over UDP multicast on the
	  local segment, so no router is needed. Peer mode additionally requires
	  CONFIG_ZENOH_PICO_LINK_UDP_MULTICAST=y and CONFIG_ZENOH_PICO_SCOUTING=y
	  in the build.

config SPINALI_SYNAPSE_ZENOH_MODE_CLIENT
	bool "Client (connect to a router)"

config SPINALI_SYNAPSE_ZENOH_MODE_PEER
	bool "Peer (router-less multicast mesh)"

endchoice

config ZENOH_LOCATOR
	string "Zenoh endpoint locator"
	default "tcp/10.58.0.1:7447" if SPINALI_SYNAPSE_ZENOH_MODE_CLIENT
	default "udp/224.0.0.224:7446" if SPINALI_SYNAPSE_ZENOH_MODE_PEER
	help
	  In client mode, the zenoh router address to connect to. In peer mode,
	  the UDP multicast locator used for peer discovery on the local segment.

config SPINALI_SYNAPSE_ZENOH_NAMESPACE
	string "Deployment namespace for bare catalog keys"
	default ""
	help
	  Optional deployment namespace, for example "cub1": topics using a
	  bare catalog key such as flow publish as <namespace>/<key>. Empty
	  publishes the bare key. Multi-segment namespaces such as "lab/cub1"
	  are allowed; do not use leading or trailing slashes. This must match
	  the namespace the receiving vehicle is configured with.

config SPINALI_SYNAPSE_ZENOH_ARGUS_POINTCLOUD
	bool "Publish the argus per-pixel point cloud"
	default n
	depends on ZROS_SENSE_STREAM_ARGUS
	help
	  Publish the AFBR-S50 per-pixel range and intensity point cloud
	  (catalog key "argus", 328-byte samples at the ranger frame rate) so
	  an offboard consumer can reconstruct the 32-zone depth image. This
	  stream is bandwidth and compute heavy for what is normally a
	  diagnostic view, so leave it off unless something offboard actually
	  consumes it; the fused scalar range already rides on the optical
	  flow topics.

module = SPINALI_SYNAPSE_ZENOH
module-str = synapse_zenoh
source "subsys/logging/Kconfig.template.log_config"

endif # SPINALI_SYNAPSE_ZENOH
