config SPINALI_SYNAPSE_ZENOH
	bool "Zenoh Transport"
	default n
	depends on ZROS
	help
	  Zenoh transport publishing the synapse optical flow topics as
	  raw fixed-layout structs tagged with their catalog value contract.

if SPINALI_SYNAPSE_ZENOH

config ZENOH_LOCATOR
	string "Zenoh router locator"
	default "tcp/192.0.2.2:7447"
	help
	  Zenoh router address to connect to in client mode.

config SPINALI_SYNAPSE_ZENOH_NAMESPACE
	string "Deployment namespace for bare catalog keys"
	default ""
	help
	  Optional deployment namespace, for example "cub1": topics using a
	  bare catalog key such as flow publish as <namespace>/<key>. Empty
	  publishes the bare key. Multi-segment namespaces such as "lab/cub1"
	  are allowed; do not use leading or trailing slashes. This must match
	  the namespace the receiving vehicle is configured with.

module = SPINALI_SYNAPSE_ZENOH
module-str = synapse_zenoh
source "subsys/logging/Kconfig.template.log_config"

endif # SPINALI_SYNAPSE_ZENOH
