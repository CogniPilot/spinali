config SPINALI_SYNAPSE_WIRE
	bool "Direct Synapse UDP/IPv6 publisher"
	default n
	depends on ZROS
	depends on NETWORKING
	depends on NET_IPV6
	depends on NET_UDP
	depends on NET_SOCKETS
	depends on NET_VLAN
	help
	  Publish selected fixed-layout Synapse samples through the direct
	  synapse_wire UDP/IPv6 path. This transport does not use Zenoh.

if SPINALI_SYNAPSE_WIRE

choice SPINALI_SYNAPSE_WIRE_TOPIC
	prompt "Direct-wire topic"
	default SPINALI_SYNAPSE_WIRE_TOPIC_OPTICAL_FLOW if SPINALI_VEHICLE_OPTICAL_FLOW
	default SPINALI_SYNAPSE_WIRE_TOPIC_GNSS_FIX if ZROS_SENSE_GNSS

config SPINALI_SYNAPSE_WIRE_TOPIC_OPTICAL_FLOW
	bool "OpticalFlowVelocity"
	depends on SPINALI_VEHICLE_OPTICAL_FLOW

config SPINALI_SYNAPSE_WIRE_TOPIC_GNSS_FIX
	bool "GnssFix"
	depends on ZROS_SENSE_GNSS

endchoice

config SPINALI_SYNAPSE_WIRE_DESTINATION
	string "Destination IPv6 address"
	default "fe80::4:9fff:fe00:150"

config SPINALI_SYNAPSE_WIRE_DESTINATION_MAC
	string "Destination Ethernet address"
	default "02:04:9f:00:01:50"

config SPINALI_SYNAPSE_WIRE_SOURCE_NODE_ID
	int "Source node ID"
	range 1 4294967295
	default 12 if SPINALI_SYNAPSE_WIRE_TOPIC_OPTICAL_FLOW
	default 11 if SPINALI_SYNAPSE_WIRE_TOPIC_GNSS_FIX

config SPINALI_SYNAPSE_WIRE_PORT
	int "UDP port"
	range 1 65535
	default 46010 if SPINALI_SYNAPSE_WIRE_TOPIC_OPTICAL_FLOW
	default 46008 if SPINALI_SYNAPSE_WIRE_TOPIC_GNSS_FIX

config SPINALI_SYNAPSE_WIRE_VLAN_ID
	int "Application VLAN ID"
	range 1 4094
	default 58

config SPINALI_SYNAPSE_WIRE_PCP
	int "Application VLAN priority"
	range 0 7
	default 5

config SPINALI_SYNAPSE_WIRE_RATE_HZ
	int "Maximum publish rate"
	range 1 1000
	default 70 if SPINALI_SYNAPSE_WIRE_TOPIC_OPTICAL_FLOW
	default 10 if SPINALI_SYNAPSE_WIRE_TOPIC_GNSS_FIX

config SPINALI_SYNAPSE_WIRE_THREAD_STACK_SIZE
	int "Direct-wire publisher stack size"
	range 1024 8192
	default 2048

config SPINALI_SYNAPSE_WIRE_THREAD_PRIORITY
	int "Direct-wire publisher priority"
	default 6

module = SPINALI_SYNAPSE_WIRE
module-str = synapse_wire
source "subsys/logging/Kconfig.template.log_config"

endif
